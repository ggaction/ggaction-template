{
  "name": "{{packageName}}",
  "version": "{{packageVersion}}",
  "description": {{descriptionYaml}},
  {{authorJsonProperty}}"license": "{{license}}",
  "type": "module",
  "sideEffects": [
    "./src/index.js"
  ],
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./src/index.js"
    }
  },
  "types": "./types/index.d.ts",
  "files": [
    "src",
    "types",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "spec:generate": "node scripts/spec.js --write",
    "spec:validate": "node scripts/spec.js --check",
    "docs:profile:check": "node scripts/docs.js profile",
    "docs:generate": "node scripts/docs.js generate",
    "docs:verify": "node scripts/docs.js verify",
    "package:test": "node scripts/package-consumer.js",
    "test": "node --test",
    "typecheck": "tsc --noEmit",
    "verify": "npm run spec:validate && npm run docs:verify && npm test && npm run typecheck && npm run package:test"
  },
  "repository": {
    "type": "git",
    "url": "{{repositoryUrl}}"
  },
  "peerDependencies": {
    "ggaction": "{{ggactionVersion}}"
  },
  "devDependencies": {
    "ggaction": "{{ggactionVersion}}",
    "marked": "18.0.9",
    "typescript": "{{typescriptVersion}}",
    "yaml": "2.9.0"
  },
  "engines": {
    "node": ">=20"
  }
}
